Makefile
.qmake.stash
*.o
moc_*.cpp
moc_*.h
# in-source builds put moc output for "#include \"tst_x.moc\"" next to the source
*.moc
# generated by CONFIG += testcase
tests/target_wrapper.sh
qrc_*.cpp
ui_*.h
/harbour-mynews
/RPMS/
tools/cluster-harness/RPMS/
tools/cluster-harness/cluster-harness
tools/ingest-cli/RPMS/
tools/ingest-cli/ingest-cli
