tests/tst_mynews
/installroot/
/build/

# lrelease output, and the lupdate extraction template -- both regenerated on every
# build. The per-language .ts files are the tracked sources.
translations/*.qm
translations/harbour-mynews.ts

# editors
*.autosave
*~
.kdev4/
*.user

# sfdk build artefact
documentation.list

# Fetched publisher content -- development corpus for the clustering harness.
# Never commit this: section 11 of the plan rules out redistributing article content,
# and a JSON of titles and teasers in a public repo would be exactly that.
/corpus*.json

# Local databases written by the development tools -- publisher content again.
*.db
*.db-wal
*.db-shm

# rpmbuild leftovers
debugfiles.list
debuglinks.list
debugsourcefiles.list
debugsources.list
elfbins.list
